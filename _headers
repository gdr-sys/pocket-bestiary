# Intestazioni di sicurezza per Cloudflare Pages.
# La CSP elenca solo i servizi che l'app usa davvero: Firebase (accesso e database, caricato da
# www.gstatic.com), l'accesso con Google e le statistiche anonime di Cloudflare. 'unsafe-inline'
# resta per lo script del tema nella testa della pagina e per gli stili scritti dalle schede.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://apis.google.com https://accounts.google.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.googleapis.com https://*.firebaseapp.com https://www.gstatic.com https://accounts.google.com https://cloudflareinsights.com; frame-src 'self' https://accounts.google.com https://compendio-arcano-431f9.firebaseapp.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Il service worker scarica per conto della pagina: la sua CSP deve permetterglielo.
/sw.js
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; connect-src 'self' https: wss:; script-src 'self'; object-src 'none'; base-uri 'self'
  Cache-Control: no-cache

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=604800

# L'indice delle illustrazioni cambia a ogni aggiornamento: sempre controllato
/img/mostri/indice.json
  ! Cache-Control
  Cache-Control: no-cache

/data/*
  Cache-Control: public, max-age=86400
